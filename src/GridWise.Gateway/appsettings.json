{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The public API: /api/<service>/... goes to the service with the prefix removed (the paths nginx used before).
  // The addresses are the compose service names; override them with environment variables,
  // for example ReverseProxy__Clusters__catalog__Destinations__main__Address=http://localhost:5101/
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "recommendation": {
        "ClusterId": "recommendation",
        "Match": { "Path": "/api/recommendation/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/recommendation" } ]
      },
      // CSV uploads: the batch service allows 10 MB, so the gateway lets 11 MB through (like nginx) and the service answers.
      // The progress stream (/api/batch/jobs/{id}/events, server-sent events) is a route of its own: YARP streams it without
      // buffering, and the 15 s heartbeat of the stream stays well inside the 100 s idle timeout of the cluster.
      "batch-events": {
        "ClusterId": "batch",
        "Order": 1,
        "Match": { "Path": "/api/batch/jobs/{id}/events" },
        "Transforms": [ { "PathRemovePrefix": "/api/batch" } ]
      },
      "batch": {
        "ClusterId": "batch",
        "Order": 2,
        "MaxRequestBodySize": 11534336,
        "Match": { "Path": "/api/batch/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/batch" } ]
      }
    },
    "Clusters": {
      "catalog": { "Destinations": { "main": { "Address": "http://catalog:8080/" } } },
      "recommendation": { "Destinations": { "main": { "Address": "http://recommendation:8080/" } } },
      "batch": { "Destinations": { "main": { "Address": "http://batch:8080/" } } }
    }
  }
}
