# Optional. Copy to .env to change a value; without a .env file every variable below uses the default shown.
# The defaults are for local development only: never reuse them anywhere else.

# Passwords of the databases (each service has its own database and user)
CATALOG_DB_PASSWORD=catalog_dev_pw
RECOMMENDATION_DB_PASSWORD=recommendation_dev_pw
BATCH_DB_PASSWORD=batch_dev_pw

# Host ports (the left side of the port mappings)
WEB_PORT=5100
CATALOG_PORT=5101
RECOMMENDATION_PORT=5102
BATCH_PORT=5103
CATALOG_DB_PORT=5432
RECOMMENDATION_DB_PORT=5433
BATCH_DB_PORT=5434
KAFKA_EXTERNAL_PORT=9094

# ASP.NET environment of the services (Development also turns on the Scalar API reference)
ASPNETCORE_ENVIRONMENT=Development

# Container images
POSTGRES_IMAGE=postgres:17-alpine
KAFKA_IMAGE=apache/kafka:4.4.0

# Kafka broker heap (small, for a laptop)
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M

# Partitions of every topic created at start, except batch.chunks (always 6) (topics are created once: changing it later does not resize existing topics)
KAFKA_PARTITIONS=3

# Log level of the .NET services (Trace, Debug, Information, Warning, Error)
LOG_LEVEL=Information

# Observability: Grafana (traces, logs, metrics) on this host port, and the image of the Grafana + OpenTelemetry stack
# (about 0.6 GB of memory when idle and a 1 GB image). The services send OTLP over HTTP to this address inside the network.
GRAFANA_PORT=3000
OTEL_LGTM_IMAGE=grafana/otel-lgtm:0.40.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# Identity: Keycloak (dev mode). The bootstrap admin of the master realm, for the admin console at http://localhost:5100/auth/admin.
# KEYCLOAK_HOSTNAME is the public address of Keycloak (through nginx); by default it follows WEB_PORT.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin_dev_pw
# KEYCLOAK_HOSTNAME=http://localhost:5100/auth
