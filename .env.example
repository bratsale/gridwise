# Optional. Copy to .env to change a value; without a .env file every variable below uses the default shown.
# The defaults are for local development only: never reuse them anywhere else.

# Passwords of the databases (each service has its own database and user)
CATALOG_DB_PASSWORD=catalog_dev_pw
RECOMMENDATION_DB_PASSWORD=recommendation_dev_pw
BATCH_DB_PASSWORD=batch_dev_pw

# Host ports (the left side of the port mappings)
WEB_PORT=5100
CATALOG_PORT=5101
RECOMMENDATION_PORT=5102
BATCH_PORT=5103
CATALOG_DB_PORT=5432
RECOMMENDATION_DB_PORT=5433
BATCH_DB_PORT=5434
KAFKA_EXTERNAL_PORT=9094

# ASP.NET environment of the services (Development also turns on the Scalar API reference)
ASPNETCORE_ENVIRONMENT=Development

# Container images
POSTGRES_IMAGE=postgres:17-alpine
KAFKA_IMAGE=apache/kafka:4.4.0

# Kafka broker heap (small, for a laptop)
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M

# Partitions of every topic created at start, except batch.chunks (always 6) (topics are created once: changing it later does not resize existing topics)
KAFKA_PARTITIONS=3
